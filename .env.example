# ─────────────────────────────────────────────────────────
# .env.example — copia in .env e compila i valori reali
# NON committare mai il file .env su git
# ─────────────────────────────────────────────────────────

# Django core
SECRET_KEY=django-insecure-CAMBIA-QUESTO-GENERA-CON-manage.py-shell
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ENVIRONMENT=development

# Database PostgreSQL
DB_NAME=myproject_db
DB_USER=myproject_user
DB_PASSWORD=password_locale
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Email (sviluppo: usa console backend)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tua@email.com
EMAIL_HOST_PASSWORD=app_password_gmail

# Sentry (lascia vuoto in sviluppo)
SENTRY_DSN=
